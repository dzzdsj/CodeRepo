# 复制为 .env 后按需修改；.env 不要提交到版本库
DEBUG=true
CORS_ORIGINS=["http://localhost:5173"]

# 默认使用本地 SQLite；PostgreSQL 示例：postgresql+psycopg://user:pass@localhost:5432/aidevops
DATABASE_URL=sqlite:///./aidevops.db

# 生产环境务必替换为随机强密钥（例如：python -c "import secrets; print(secrets.token_hex(32))"）
JWT_SECRET_KEY=dev-insecure-secret-please-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
